# Copy this file to .env and put your own keys in it.
# Never upload .env: it is listed in .gitignore.

# LiveKit Cloud: cloud.livekit.io → your project → Settings → API keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Deepgram (speech to text, text to speech): console.deepgram.com
DEEPGRAM_API_KEY=

# Groq (LLM): console.groq.com/keys
GROQ_API_KEY=
